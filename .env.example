# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions: Copy this file to .env and adjust values according to your setup.
# Run: cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Data Warehouse Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=olist_dw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SCHEMA=public

# ------------------------------------------------------------------------------
# Apache Airflow Configuration
# ------------------------------------------------------------------------------
# Docker compose Airflow settings
AIRFLOW_IMAGE_NAME=apache/airflow:2.7.3-python3.10
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True

# ------------------------------------------------------------------------------
# Apache Spark / PySpark Configuration
# ------------------------------------------------------------------------------
SPARK_APP_NAME=OlistEcommercePipeline
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g

# ------------------------------------------------------------------------------
# Local Data Storage Paths (relative to project root)
# ------------------------------------------------------------------------------
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
ANALYTICS_DATA_PATH=./data/analytics
